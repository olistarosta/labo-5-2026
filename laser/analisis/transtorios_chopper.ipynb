    "def leer_archivo(L, f, p, ventana, counter):\n",
    "    L_text = f\"_L{L:.1f}\" if L != 6.2 else \"\"\n",
    "    nombre_archivo = f\"laser_chopper{L_text}_f{f:.0f}_p{p:.2f}_{ventana}_{counter}.csv\"\n",
    "    ruta = \"../datos/\" + nombre_archivo\n",
    "\n",
    "    df = pd.read_csv(ruta)\n",
    "    return df"
   ]
