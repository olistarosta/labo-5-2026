    "        buffer = BUFFER_FRACTION * (t1 - t0)\n",
    "        t1_efectivo = t1 - buffer\n",
    " \n",
    "        mask = (t >= t0) & (t <= t1_efectivo)\n",
    "        t_seg = t[mask]\n",
    "        v_seg = v[mask]\n",
